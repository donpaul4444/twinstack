# Copy this file to .env and adjust values for your machine.
PORT=4000
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Where client submissions are stored (JSON file).
DATA_DIR=./data

# Admin login. Defaults are hardcoded in src/config.ts (admin / Twinstack@2026).
# Set these to override them, especially when deploying.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me
# JWT_SECRET=a-long-random-string
